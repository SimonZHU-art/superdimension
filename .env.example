# Select openai or deepseek. Only the selected provider credentials are used.
MODEL_PROVIDER=openai
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Required for protected island owner management. No default password exists.
# Generate your own unique password with at least 12 characters.
OWNER_PASSWORD=

# A real OpenAI project API key and a Responses / JSON Schema compatible model.
# The model is intentionally not guessed. Use a model available to your project.
OPENAI_API_KEY=
OPENAI_MODEL=
MODEL_TIMEOUT_MS=90000

# Select smtp for a personal mailbox, or resend for a verified sending domain.
MAIL_PROVIDER=resend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail: app password; QQ: SMTP authorization code. Never use the sign-in password.
SMTP_PASSWORD=

# Resend requires a verified sender domain/address. Visitor reply email is verified
# by a code sent through this same provider. Owner recipient is configured in UI.
RESEND_API_KEY=
MAIL_FROM=

# Local development defaults. Vite proxies API, identity and test-island routes.
HOST=127.0.0.1
PORT=8787
DATA_PATH=./server/data/island.sqlite
QUEUE_INTERVAL_MS=1000

# Public deployment origin (HTTPS); also scopes public test-island links and cookies.
# Leave empty for local use; set to your exact production origin when publishing.
PUBLIC_BASE_URL=
COOKIE_SECURE=false
# Optional comma-separated exact trusted frontend origins. Usually keep empty.
ALLOWED_ORIGINS=

# Real per-visit caps; failed/uncertain model requests also consume the allowance.
MAX_VISIT_MODEL_CALLS=24
MAX_VISIT_TOTAL_TOKENS=350000
# Optional monetary cap. Both actual model token prices must be configured when
# setting MAX_VISIT_COST_USD. Estimates are labeled unavailable if rates are empty.
MAX_VISIT_COST_USD=
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
